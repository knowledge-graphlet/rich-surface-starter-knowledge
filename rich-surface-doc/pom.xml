<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.komet</groupId>
        <artifactId>rich-surface-starter-knowledge</artifactId>
    </parent>

    <artifactId>rich-surface-doc</artifactId>
    <packaging>pom</packaging>

    <name>Rich Surface Starter Knowledge — Guide</name>
    <description>
        Documentation for the RichSurfaceTerms starter knowledge: the ledger model,
        the content inventory it realizes, and how the change-set artifacts are
        built, reviewed, and released.
    </description>

    <properties>
        <pdf.source.document>rich-surface-guide</pdf.source.document>
        <!-- Renderers on by default, as the ike-platform source sets them. Published
             ike-platform POMs from 185 on carry these flags baked to true
             (IKE-Network/ike-issues#1167: Maven 4.0.0-rc-7 writes the release build's
             active-profile values into the consumer POM). Remove this block once
             ike-parent is released on Maven 4.0.0 GA, which carries the fix
             (apache/maven#13761). A command-line -Dike.skip.* still overrides these. -->
        <ike.skip.html>false</ike.skip.html>
        <ike.skip.html-single>false</ike.skip.html-single>
        <ike.skip.prince>false</ike.skip.prince>
        <ike.skip.pdf-default>false</ike.skip.pdf-default>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
